generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/db/generated/prisma/client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/infrastructure/db/generated/zod"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Database Enums  ─────────────────────────────────────────────────

enum QuotationStatus {
  PENDING // just submitted
  REVIEWED // admin has seen it
  SENT // admin sent a response/offer
  ACCEPTED
  REJECTED
  CLOSED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  CUSTOMER
  GUEST
}

// ─── Sales & Inventory Enums ─────────────────────────────────────────

enum PaymentMethod {
  CASH
  OPEN_ACCOUNT
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum ReturnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum MovementType {
  SALE
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum LedgerEntryType {
  SALE_CHARGE
  RETURN_CREDIT
  PAYMENT_RECEIPT
  MANUAL_ADJUSTMENT
}

enum DocumentType {
  SALE
  RETURN
  TRANSFER
  PAYMENT
  MANUAL_ADJUSTMENT
  MIGRATION
}

// ─── Database Models ─────────────────────────────────────────────────

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String? // e.g. "Home", "Office"
  address_line1 String
  address_line2 String? // ← make optional (was required)
  city          String
  state         String
  country       String
  postal_code   String
  is_default    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
}

model Product {
  id                 String           @id @default(uuid())
  productName        String
  productFeatures    String[]         @default([])
  productDescription String
  productImages      String[]         @default([])
  productCadDrawing  String[]         @default([])
  productCatalogue   String[]         @default([])
  productVideos      String[]         @default([])
  childCategoryId    String
  tags               String[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  
  brandId            String?
  brand              Brand?           @relation(fields: [brandId], references: [id])

  childCategory      Category         @relation("ProductCategory", fields: [childCategoryId], references: [id])
  productVariants    ProductVariant[] @relation("ProductSKUs")

  @@index([brandId])
}

model ProductVariant {
  id             String     @id @default(uuid())
  SKU            String     @unique
  productId      String
  attributes     Json // e.g. { "color": "red", "size": "XL" }
  price          Decimal    @db.Decimal(10, 2)
  compareAtPrice Decimal?   @db.Decimal(10, 2) 
  
  // DEPRECATED: Legacy stock. Use WarehouseStock + InventoryMovement instead.
  stock          Int        @default(0)
  
  reorderStock   Decimal    @default(0) @db.Decimal(12, 3)

  images         String[]   @default([])
  isActive       Boolean    @default(true)
  cartItems      CartItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  product        Product    @relation("ProductSKUs", fields: [productId], references: [id])

  quotationItems QuotationItem[]
  orderItems     OrderItem[]

  warehouseStocks          WarehouseStock[]
  warehouseVariantSettings WarehouseVariantSetting[]
  inventoryMovements       InventoryMovement[]
  transferItems            InventoryTransferItem[]
  saleItems                SaleItem[]
  saleReturnItems          SaleReturnItem[]
}

model Category {
  id                    String     @id @default(uuid())
  categoryName          String
  parentCategoryId      String?
  tags                  String[]
  parentCategory        Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children              Category[] @relation("CategoryHierarchy")
  childCategoryProducts Product[]  @relation("ProductCategory")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id               String         @id @default(uuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  ProductVariantId String
  ProductVariant   ProductVariant @relation(fields: [ProductVariantId], references: [id])
  quantity         Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cartId, ProductVariantId])
}

model Quotation {
  id        String          @id @default(uuid())
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  status    QuotationStatus @default(PENDING)
  notes     String? // overall request notes from the user
  items     QuotationItem[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  orders Order?
}

model QuotationItem {
  id               String         @id @default(uuid())
  quotationId      String
  quotation        Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  ProductVariantId String
  ProductVariant   ProductVariant @relation(fields: [ProductVariantId], references: [id])
  quantity         Int
  notes            String?

  // ─── Snapshot fields ──────────────────────────────────────────────
  snapshotSKU         String
  snapshotAttributes  Json
  snapshotImages      String[]
  snapshotProductName String
  snapshotProductId   String
  // ──────────────────────────────────────────────────────────────────

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, ProductVariantId])
}

model Order {
  id                String      @id @default(uuid())
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  quotationId       String      @unique
  quotation         Quotation   @relation(fields: [quotationId], references: [id])
  status            OrderStatus @default(PENDING_PAYMENT)
  items             OrderItem[]
  totalAmount       Decimal     @db.Decimal(10, 2)
  shippingAddressId String?
  shippingAddress   Address?    @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  snapshotAddress   Json
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ProductVariantId String
  ProductVariant   ProductVariant @relation(fields: [ProductVariantId], references: [id])
  quantity         Int
  unitPrice        Decimal        @db.Decimal(10, 2)

  // ─── Snapshot fields ────────────────────────────────────────────────
  snapshotSKU         String
  snapshotAttributes  Json
  snapshotImages      String[]
  snapshotProductName String
  snapshotProductId   String
  // ────────────────────────────────────────────────────────────────────

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, ProductVariantId])
}

model User {
  id            String   @id @default(uuid())
  name          String
  firstName     String?
  lastName      String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(CUSTOMER)
  isBanned      Boolean  @default(false)
  banReason     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions   Session[]
  accounts   Account[]
  quotations Quotation[]
  addresses  Address[]
  orders     Order[]
  cart       Cart?

  inventoryMovements  InventoryMovement[]
  inventoryTransfers  InventoryTransfer[]
  clientLedgerEntries ClientLedgerEntry[]
  clientPayments      ClientPayment[]
  sales               Sale[]
  saleReturns         SaleReturn[]
  auditLogs           AuditLog[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Master Data Models ──────────────────────────────────────────────

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks           WarehouseStock[]
  variantSettings  WarehouseVariantSetting[]
  movements        InventoryMovement[]
  transfersOut     InventoryTransfer[]       @relation("SourceWarehouse")
  transfersIn      InventoryTransfer[]       @relation("DestWarehouse")
  sales            Sale[]
  saleReturns      SaleReturn[]
}

model Client {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  isOpenAccountEnabled Boolean  @default(false)
  isBlocked            Boolean  @default(false)
  creditLimit          Decimal? @db.Decimal(12, 2)
  
  // CACHED PROJECTION: Updated strictly in the same DB transaction as ClientLedgerEntry
  currentBalance       Decimal  @default(0) @db.Decimal(12, 2) 
  
  contactInfo          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  ledgerEntries ClientLedgerEntry[]
  payments      ClientPayment[]
  sales         Sale[]
  saleReturns   SaleReturn[]

  @@index([isOpenAccountEnabled, isBlocked])
}

// ─── Inventory & Stock Models ────────────────────────────────────────

model WarehouseStock {
  id          String   @id @default(uuid())
  warehouseId String
  variantId   String
  
  // CACHED PROJECTION: Updated strictly in the same DB transaction as InventoryMovement
  quantity    Decimal  @default(0) @db.Decimal(12, 3) 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([warehouseId, variantId])
  @@index([variantId])
}

model WarehouseVariantSetting {
  id           String   @id @default(uuid())
  warehouseId  String
  variantId    String
  reorderStock Decimal  @default(0) @db.Decimal(12, 3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([warehouseId, variantId])
}

model InventoryMovement {
  id              String       @id @default(uuid())
  warehouseId     String
  variantId       String
  type            MovementType
  
  // ALWAYS POSITIVE. Direction (in/out) is determined by the `type` field.
  quantity        Decimal      @db.Decimal(12, 3) 
  
  referenceId     String?      
  referenceType   DocumentType? 
  createdByUserId String?
  happenedAt      DateTime     // Business event time
  createdAt       DateTime     @default(now()) 

  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  createdByUser User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([warehouseId, variantId, happenedAt])
  @@index([referenceId, referenceType])
}

model InventoryTransfer {
  id                String         @id @default(uuid())
  transferNumber    String         @unique
  sourceWarehouseId String
  destWarehouseId   String
  status            TransferStatus @default(DRAFT)
  notes             String?
  createdByUserId   String?
  transferredAt     DateTime?      // Lifecycle timestamp
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sourceWarehouse Warehouse               @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destWarehouse   Warehouse               @relation("DestWarehouse", fields: [destWarehouseId], references: [id])
  createdByUser   User?                   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           InventoryTransferItem[]

  @@index([sourceWarehouseId])
  @@index([destWarehouseId])
  @@index([status])
  @@index([transferredAt])
}

model InventoryTransferItem {
  id         String  @id @default(uuid())
  transferId String
  variantId  String
  quantity   Decimal @db.Decimal(12, 3)

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant    @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@index([variantId])
}

// ─── Sales & Returns Models ──────────────────────────────────────────

model Sale {
  id              String        @id @default(uuid())
  saleNumber      String        @unique
  warehouseId     String
  clientId        String?
  cashClientName  String?
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  status          SaleStatus    @default(DRAFT)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(12, 2)
  amountDue       Decimal       @default(0) @db.Decimal(12, 2)
  notes           String?
  soldAt          DateTime?     // Lifecycle timestamp
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
  client        Client?      @relation(fields: [clientId], references: [id])
  createdByUser User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  returns       SaleReturn[]

  @@index([warehouseId])
  @@index([clientId])
  @@index([soldAt])
  @@index([status])
  @@index([paymentStatus])
}

model SaleItem {
  id                  String  @id @default(uuid())
  saleId              String
  variantId           String
  productNameSnapshot String
  skuSnapshot         String?
  attributesSnapshot  Json?
  listPrice           Decimal @db.Decimal(12, 2)
  unitPrice           Decimal @db.Decimal(12, 2)
  quantity            Decimal @db.Decimal(12, 3)
  lineTotal           Decimal @db.Decimal(12, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([saleId])
  @@index([variantId])
}

model SaleReturn {
  id              String       @id @default(uuid())
  returnNumber    String       @unique
  originalSaleId  String?
  warehouseId     String
  clientId        String?
  status          ReturnStatus @default(DRAFT)
  subtotal        Decimal      @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal      @default(0) @db.Decimal(12, 2)
  notes           String?
  returnedAt      DateTime?    // Lifecycle timestamp
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  originalSale  Sale?            @relation(fields: [originalSaleId], references: [id])
  warehouse     Warehouse        @relation(fields: [warehouseId], references: [id])
  client        Client?          @relation(fields: [clientId], references: [id])
  createdByUser User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         SaleReturnItem[]

  @@index([originalSaleId])
  @@index([warehouseId])
  @@index([clientId])
  @@index([returnedAt])
  @@index([status])
}

model SaleReturnItem {
  id           String  @id @default(uuid())
  saleReturnId String
  variantId    String
  quantity     Decimal @db.Decimal(12, 3)
  refundPrice  Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)

  saleReturn SaleReturn     @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@index([saleReturnId])
  @@index([variantId])
}

// ─── Financial Ledger Models ─────────────────────────────────────────

model ClientLedgerEntry {
  id              String          @id @default(uuid())
  clientId        String
  type            LedgerEntryType
  
  // ALWAYS POSITIVE. Impact on balance is determined by the `type` field.
  amount          Decimal         @db.Decimal(12, 2) 
  balanceAfter    Decimal         @db.Decimal(12, 2) 
  
  referenceId     String?         
  referenceType   DocumentType? 
  createdByUserId String?
  happenedAt      DateTime        // Business event time
  createdAt       DateTime        @default(now()) 

  client        Client @relation(fields: [clientId], references: [id])
  createdByUser User?  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clientId, happenedAt])
  @@index([referenceId, referenceType])
}

model ClientPayment {
  id              String   @id @default(uuid())
  paymentNumber   String   @unique
  clientId        String
  amount          Decimal  @db.Decimal(12, 2)
  paymentDate     DateTime
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client        Client @relation(fields: [clientId], references: [id])
  createdByUser User?  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([paymentDate])
}

// ─── System Audit ────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  entityName String   
  entityId   String
  action     String   
  changes    Json?    
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@index([createdAt])
  @@index([userId])
}
