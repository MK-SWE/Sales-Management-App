# Public application URL used for self-referential links and auth callbacks.
APP_URL="http://localhost:3000"

# PostgreSQL connection string used by Prisma and Better Auth.
DATABASE_URL="postgresql://postgres:prisma@localhost:5434/sales_management_app?schema=public"

# Better Auth base URL and secret.
# BETTER_AUTH_URL should usually match APP_URL in deployed environments.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
